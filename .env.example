# ─────────────────────────────────────────────────────────────────
# Google Earth Engine – Service Account Credentials
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PROJECT_ID=your-project-id
GEE_PRIVATE_KEY_ID=your-private-key-id
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GEE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_CLIENT_ID=your-client-id
GEE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GEE_TOKEN_URI=https://oauth2.googleapis.com/token
GEE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GEE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com

# ─────────────────────────────────────────────────────────────────
# Google Earth Engine – OAuth User Credentials
# ─────────────────────────────────────────────────────────────────
GEE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GEE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GEE_OAUTH_REFRESH_TOKEN=your-refresh-token
GEE_OAUTH_PROJECT=your-project-number
